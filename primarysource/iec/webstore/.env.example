# Copy to a file OUTSIDE any git repository, fill in, and load it into the environment yourself.
# Never commit real values. The catalog search is anonymous and needs none of the credentials below;
# they are only for owned-item lookup, download and the free-order path.
PRIMARYSOURCE_IEC_USERNAME=
PRIMARYSOURCE_IEC_PASSWORD=
# Optional: cookie jar (LWP format), outside any repository; written 0600 after a login.
PRIMARYSOURCE_IEC_SESSION_FILE=
# Optional: where the catalogue lives (<home>/webstore).
PRIMARYSOURCE_IEC_HOME=
# Optional: auto | on-demand | offline (offline stops every request).
PRIMARYSOURCE_IEC_NETWORK=
