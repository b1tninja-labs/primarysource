# Copy to a file OUTSIDE any git repository, fill in, and load it into the environment yourself.
# Never commit real values. The catalog sync is anonymous and needs none of the credentials below;
# they are only for `owned`, `download`, `plan-free-order` and `free-order`.
PRIMARYSOURCE_ISO_USERNAME=
PRIMARYSOURCE_ISO_PASSWORD=
# Optional: where session cookies are cached between runs (owner-only file, outside any repository).
PRIMARYSOURCE_ISO_TOKEN_FILE=
# Optional: where the collection (catalog stubs, index, downloads) lives.
PRIMARYSOURCE_ISO_HOME=
# Optional: auto | on-demand | offline (offline stops every request).
PRIMARYSOURCE_ISO_NETWORK=
