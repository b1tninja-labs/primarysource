# Copy this to a file OUTSIDE any git repository, fill it in, and load it into your shell yourself.
# Never commit real values.
#
# TERMS ACCEPTANCE. Each local-only collection refuses to import or serve until its variable is set to 1.
# Setting one is YOUR assertion that you have read the publisher's terms for the files in that collection's home
# and accept them. primarysource records the assertion (variable, UTC time, document ids) in the collection's
# install.json; it does not check anyone's licence. Leave a line blank to leave that collection locked.
PRIMARYSOURCE_GM_ACCEPT_TERMS=
PRIMARYSOURCE_CAN_ACCEPT_TERMS=
PRIMARYSOURCE_SAE_ACCEPT_TERMS=

# WHERE THE COLLECTIONS LIVE (optional; the default is %LOCALAPPDATA%\primarysource\<name>).
# Your PDFs and the extractions go here, never in the repository or an image.
PRIMARYSOURCE_GM_HOME=
PRIMARYSOURCE_CAN_HOME=
PRIMARYSOURCE_SAE_HOME=
PRIMARYSOURCE_ISO_HOME=

# The `iso` collection has no terms variable (it is not gated). The ISO and IEC webstore credentials are in
# primarysource/iso/webstore/.env.example and primarysource/iec/webstore/.env.example.
