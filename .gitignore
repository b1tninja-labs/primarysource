# No document text lives in this repository: tests use invented text only.
.venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/
.coverage
.coverage.*
htmlcov/

# Anything that could carry a corpus, by file type. A stray download is then never staged.
*.pdf
*.epub
*.doc
*.docx
*.rtf
*.zip
*.zim
# ZIM files in every spelling (the `zim` collection): a ZIM is one binary file that git history cannot take back.
# `/zim/` is anchored: the collection's own code is primarysource/zim/ and tests/zim/.
*.zim.*
*.zimaa
*.meta4
*.idx.tmp/
/zim/
zimlore-home/
.zimlore/
*.sqlite3
*.sqlite3-journal
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.csv.gz
.cvelib/

# Captures and secrets
*.har
.env
.env.*
*.pem
*.key

# Scratch: the workspace pre-commit hook refuses these
probe_*.py
*.log
*.out
*.tmp
scratch/
tmp/

# Agent worktrees and local tool state
.claude/worktrees/
.claude/settings.local.json
.vscode/
.idea/

.DS_Store
Thumbs.db
desktop.ini

# A collection fetch target, should one ever be pointed inside the tree (itu licence test checks this)
/corpus/
